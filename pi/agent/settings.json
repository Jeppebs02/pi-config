{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.6.0",
  "theme": "gold-noir",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "zai/glm-5.3": "max",
    "zai/glm-5.3-flash": "max"
  },
  "enabledModels": [
    "zai/glm-5.3-flash",
    "zai/glm-5.3",
    "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash-1017",
    "moonshotai/kimi-k3"
  ],
  "defaultProjectTrust": "ask",
  "packages": [
    "npm:pi-web-access",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-zentui",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "https://github.com/amosblomqvist/pi-observational-memory",
    "npm:pi-subagents",
    "npm:@blackbelt-technology/pi-agent-dashboard"
  ],
  "observational-memory": {
    "models": {
      "observer": {
        "provider": "zai",
        "id": "glm-5.3-flash",
        "thinking": "low"
      },
      "consolidator": {
        "provider": "zai",
        "id": "glm-5.3-flash",
        "thinking": "medium"
      }
    }
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.5.1",
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.89.2"
  }
}

{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.1",
  "theme": "gold-noir",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3-flash",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "zai/glm-5.3": "max",
    "zai/glm-5.3-flash": "max"
  },
  "enabledModels": [
    "zai/glm-5.3-flash",
    "zai/glm-5.3",
    "deepseek/deepseek-v4-flash"
  ],
  "defaultProjectTrust": "ask",
  "packages": [
    "npm:pi-web-access",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-zentui",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "https://github.com/mrexodia/toilet-pi",
    "npm:pi-sub-agent",
    "https://github.com/amosblomqvist/pi-observational-memory"
  ],
  "observational-memory": {
    "models": {
      "observer": {
        "provider": "zai",
        "id": "glm-5.3-flash",
        "thinking": "low"
      },
      "consolidator": {
        "provider": "zai",
        "id": "glm-5.3-flash",
        "thinking": "medium"
      }
    }
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.4.11",
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-sub-agent\",\"scope\":\"user\"}": "0.1.5"
  }
}
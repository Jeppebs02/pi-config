# Local-only credentials — never commit
pi/agent/auth.json

# Runtime MCP config: a symlink (created by install.sh / install.ps1) pointing
# at the tracked per-OS variant, mcp.linux.json or mcp.windows.json
pi/agent/mcp.json

# Session data, if pi ever writes into this repo instead of the real ~/.pi
pi/agent/sessions/
pi/agent/trust.json

# Pi-managed helper binaries (ripgrep, fd) — re-downloaded by pi, arch-specific
pi/agent/bin/

# Pi's own cache of the full built-in model catalog — auto-refreshed, not user config
pi/agent/models-store.json

# Cached web search / fetch results — regenerated on demand, not user config
pi/web-search-cache/

# Downloaded package code — pi re-fetches these from the "packages" list in
# settings.json on `pi install` / startup. Don't commit the equivalent of node_modules.
pi/agent/npm/
pi/agent/git/

# Pi's managed install of itself (releases/<version>/node_modules + current-version)
pi/agent/install/

# PI Dashboard runtime state (sockets, pairing identity, per-machine config)
# written by the dashboard server through the agent symlink — machine-local
pi/dashboard/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
pi/agent/mcp-cache.json

# Maker subagents publish rendered lesson images into <cwd>/viz
viz/

# Observational memory: per-session durable state lives in each project's .memory/.
# Per-session, per-machine — not shared across clones.
.memory/
pi/agent/mcp-auth.json

# Local-only credentials — never commit
pi/agent/auth.json

# Session data, if pi ever writes into this repo instead of the real ~/.pi
pi/agent/sessions/
pi/agent/trust.json

# Machine-local settings (theme, lastChangelogVersion, etc.) — noisy, not shared config
pi/agent/settings.json

# Pi-managed helper binaries (ripgrep, fd) — re-downloaded by pi, arch-specific
pi/agent/bin/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

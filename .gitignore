# Local-only credentials — never commit
pi/agent/auth.json

# Session data, if pi ever writes into this repo instead of the real ~/.pi
pi/agent/sessions/
pi/agent/trust.json

# Pi-managed helper binaries (ripgrep, fd) — re-downloaded by pi, arch-specific
pi/agent/bin/

# Pi's own cache of the full built-in model catalog — auto-refreshed, not user config
pi/agent/models-store.json

# Cached web search / fetch results — regenerated on demand, not user config
pi/web-search-cache/

# Downloaded package code — pi re-fetches these from the "packages" list in
# settings.json on `pi install` / startup. Don't commit the equivalent of node_modules.
pi/agent/npm/
pi/agent/git/

# toilet-pi: machine connect URL + auth token are secrets — see docs/toilet-pi.md.
# Commit only toilet-pi.json.example. toilet-pi-server.json (server admin token)
# is included defensively in case the server is ever run locally for testing.
pi/agent/toilet-pi.json
pi/agent/toilet-pi-server.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
pi/agent/mcp-cache.json
